{
  "name": "chyk-site",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild ts/main.ts --bundle --format=esm --target=es2022 --loader:.md=text --minify --outfile=js/main.js",
    "dev": "esbuild ts/main.ts --bundle --format=esm --target=es2022 --loader:.md=text --outfile=js/main.js --watch --servedir=.",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "^5.9.3"
  }
}
