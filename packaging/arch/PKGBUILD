# Maintainer: zgv2 <dev at bogdanbpeterson dot com>
# AUR recipe for chyk-bin: repackages the release .deb. The release job in
# .github/workflows/ci.yml fills in pkgver and the checksum and pushes it with .SRCINFO.
pkgname=chyk-bin
pkgver=1.4.0
pkgrel=1
pkgdesc="Quick video trim, crop, strip and join"
arch=('x86_64')
url="https://github.com/zgv2-dev/chyk"
license=('GPL-3.0-or-later')
depends=('mpv' 'ffmpeg' 'libglvnd' 'libxkbcommon')
provides=('chyk')
conflicts=('chyk')
source=("chyk-${pkgver}-amd64.deb::${url}/releases/download/v${pkgver}/Chyk-linux-amd64.deb")
sha256sums=('SKIP')

package() {
  bsdtar -xf data.tar.* -C "$pkgdir"
}
