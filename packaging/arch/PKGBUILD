# Arch Linux (AUR) recipe: repackages the release .deb. Publish as `chyk-bin`:
#   updpkgsums && makepkg --printsrcinfo > .SRCINFO   (then push both to the AUR repo)
# Bump pkgver with each release.
pkgname=chyk-bin
pkgver=1.2.0
pkgrel=1
pkgdesc="Quick video trim, crop and strip, with inactive-frame stripping"
arch=('x86_64')
url="https://github.com/zgv2-dev/chyk"
license=('GPL-3.0-or-later')
depends=('mpv' 'ffmpeg' 'libglvnd' 'libxkbcommon')
provides=('chyk')
conflicts=('chyk')
source=("Chyk-v${pkgver}-linux-amd64.deb::${url}/releases/download/v${pkgver}/Chyk-v${pkgver}-linux-amd64.deb")
sha256sums=('SKIP')

package() {
  bsdtar -xf data.tar.* -C "$pkgdir"
}
